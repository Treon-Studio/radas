{
  "name": "@radas/ui",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./layout/*": "./src/layout/*.tsx",
    "./layout/headers/*": "./src/layout/headers/*.tsx",
    "./layout/sidebar/*": "./src/layout/sidebar/*.tsx",
    "./styles/*": "./src/styles/*.css",
    "./figma/*": "./src/figma/*.tsx",
    "./*": "./src/*"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@radas/utils": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.3"
  }
}
