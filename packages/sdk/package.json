{
  "name": "@treon-studio/radas-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "openapi-typescript ../../contracts/radas-api-v2.openapi.json -o ./src/generated/schema.d.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "description": "Typed client for the RADAS /api/v2 control-plane (generated from the OpenAPI snapshot).",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@treon-studio/contracts": "^0.1.1",
    "openapi-fetch": "^0.13.0"
  }
}
