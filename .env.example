# Copy this file to .env for local development; never commit .env.
# Leave credentials out of this example. Generate production secrets with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Each production secret must be unique, 32+ characters, include letters and
# digits, and contain at least 16 distinct characters.
FLASK_ENV=development
DATABASE_URL=
TEST_DATABASE_URL=
# Production requires these values in the process .env (never use placeholders):
# JWT_SECRET_KEY=
# INTERNAL_CALL_SECRET=
# GLOBAL_SECRETS_ENCRYPTION_KEY=
# WORKER_REGISTRATION_SECRET=
# VAULT_SERVER_SECRET=
