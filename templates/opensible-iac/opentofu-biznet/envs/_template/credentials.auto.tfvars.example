# Copy to credentials.auto.tfvars (chmod 600) and paste your Gio credentials.
# Created in the Biznet Gio dashboard → IAM / API users.
os_auth_url      = "https://keystone.gio.space/v3"
os_username      = "REPLACE_ME_GIO_USERNAME"
os_password      = "REPLACE_ME_GIO_PASSWORD"
os_project_name  = "REPLACE_ME_GIO_PROJECT"
os_domain_name   = "Default"
