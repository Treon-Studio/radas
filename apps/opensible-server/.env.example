# Production secrets are mandatory and must be unique random values (at least
# 32 characters, with letters, digits, and at least 16 distinct characters).
# Generate each value independently; do not commit the generated .env file:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# The server and worker must receive the exact same WORKER_REGISTRATION_SECRET.
# These values are intentionally left unset so this file cannot be used as a
# production configuration by mistake.
JWT_SECRET_KEY=
INTERNAL_CALL_SECRET=
GLOBAL_SECRETS_ENCRYPTION_KEY=
WORKER_REGISTRATION_SECRET=
VAULT_SERVER_SECRET=

# REQUIRED by the server in production. Keep credentials out of this example.
DATABASE_URL=

# OPTIONAL
WORKER_MAX_CONCURRENCY=1
ADMIN_INITIAL_PASSWORD=
# Create the default org/project and safe local starter files on first boot.
SEED_STARTER_DATA=true
CORS_ALLOWED_ORIGINS=https://radas-console.pages.dev

# Scheduling System
AUTOSYNC_CHECK_INTERVAL=120
PLAYBOOK_SCHEDULER_INTERVAL=300
EXECUTION_RECOVERY_INTERVAL=600
HOST_STATUS_SCHEDULER_INTERVAL=600
