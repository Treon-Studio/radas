# REQUIRED in production (>= 32 characters each). Generate unique values with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# The server and worker must receive the exact same WORKER_REGISTRATION_SECRET.
JWT_SECRET_KEY=replace-with-a-generated-secret
INTERNAL_CALL_SECRET=replace-with-a-generated-secret
GLOBAL_SECRETS_ENCRYPTION_KEY=replace-with-a-generated-secret
WORKER_REGISTRATION_SECRET=replace-with-a-generated-secret
VAULT_SERVER_SECRET=replace-with-a-generated-secret

# OPTIONAL
WORKER_MAX_CONCURRENCY=1
ADMIN_INITIAL_PASSWORD=
# Create the default org/project and safe local starter files on first boot.
SEED_STARTER_DATA=true
CORS_ALLOWED_ORIGINS=https://radas-console.pages.dev

# Scheduling System
AUTOSYNC_CHECK_INTERVAL=120
PLAYBOOK_SCHEDULER_INTERVAL=300
EXECUTION_RECOVERY_INTERVAL=600
HOST_STATUS_SCHEDULER_INTERVAL=600