{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@radas/ui": ["./packages/ui/src"],
      "@radas/ui/*": ["./packages/ui/src/*"],
      "@radas/utils": ["./packages/utils/src"],
      "@radas/utils/*": ["./packages/utils/src/*"],
      "@radas/hooks": ["./packages/hooks/src"],
      "@radas/hooks/*": ["./packages/hooks/src/*"],
      "@radas/types": ["./packages/types/src"],
      "@radas/types/*": ["./packages/types/src/*"],
      "@radas/config": ["./packages/config/src"],
      "@radas/config/*": ["./packages/config/src/*"],
      "@radas/validation": ["./packages/validation/src"],
      "@radas/validation/*": ["./packages/validation/src/*"],
      "@radas/module-attendance": ["./modules/attendance/client"],
      "@radas/module-attendance/*": ["./modules/attendance/client/*"],
      "@radas/module-auth": ["./modules/auth/client"],
      "@radas/module-auth/*": ["./modules/auth/client/*"],
      "@radas/module-chat": ["./modules/chat/client"],
      "@radas/module-chat/*": ["./modules/chat/client/*"],
      "@radas/module-company-info": ["./modules/company-info/client"],
      "@radas/module-company-info/*": ["./modules/company-info/client/*"],
      "@radas/module-drive": ["./modules/drive/client"],
      "@radas/module-drive/*": ["./modules/drive/client/*"],
      "@radas/module-hiring": ["./modules/hiring/client"],
      "@radas/module-hiring/*": ["./modules/hiring/client/*"],
      "@radas/module-links": ["./modules/links/client"],
      "@radas/module-links/*": ["./modules/links/client/*"],
      "@radas/module-notifications": ["./modules/notifications/client"],
      "@radas/module-notifications/*": ["./modules/notifications/client/*"],
      "@radas/module-okr": ["./modules/okr/client"],
      "@radas/module-okr/*": ["./modules/okr/client/*"],
      "@radas/module-profile": ["./modules/profile/client"],
      "@radas/module-profile/*": ["./modules/profile/client/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".wxt"]
}
